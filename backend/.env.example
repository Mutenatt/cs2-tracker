# Copiar a .env (gitignored) y ajustar. Ver cs2tracker/config.py (prefijo CS2_).

# Postgres local (docker-compose.yml en la raíz de cs2-tracker/):
#   docker compose up -d
# Dejalo comentado mientras corras con SQLite (default).
# CS2_DB_URL=postgresql+psycopg://cs2tracker:cs2tracker@localhost:5432/cs2tracker

# Carpeta que vigila FolderSource (Camino 1, sigue disponible para pruebas manuales).
CS2_DEMOS_DIR=demos

# Login con Steam (auth.py). Mismo host ("localhost") que CS2_FRONTEND_URL a
# propósito -- ver el comentario en config.py sobre por qué importa para la
# cookie de sesión.
CS2_API_PUBLIC_URL=http://localhost:8000
CS2_FRONTEND_URL=http://localhost:5173

# Sin esto, se genera un secreto random al arrancar (sesiones no sobreviven
# un restart). Poner uno fijo para no desloguear a todos en cada reinicio:
#   python -c "import secrets; print(secrets.token_hex(32))"
# CS2_SESSION_SECRET=

# Opcional: https://steamcommunity.com/dev/apikey (resuelve display_name/avatar
# y el fondo de perfil, ver auth.py).
# CS2_STEAM_API_KEY=00000000000000000000000000000000

# Pro scene (Home). Twitch Helix para streams LATAM: credenciales de una app
# en dev.twitch.tv/console (client credentials, gratis). Sin ellas el bloque
# de streams responde "no configurado" sin romper nada.
# CS2_TWITCH_CLIENT_ID=
# CS2_TWITCH_CLIENT_SECRET=

# Ídem para Kick (app en kick.com -> Settings -> Developer, requiere 2FA).
# CS2_KICK_CLIENT_ID=
# CS2_KICK_CLIENT_SECRET=

# Videos de lineups (bucket R2 privado, ver infra/r2.py): GET /lineups firma
# cada video_url al vuelo. Sin esto, video_url queda como path crudo (no
# reproduce, pero no rompe el resto de /lineups).
# account_id sale de la URL del endpoint S3 en el dashboard de Cloudflare
# (https://<account_id>.r2.cloudflarestorage.com/<bucket>). El access key
# sale de R2 -> Manage API Tokens -> Create API Token, scope "Object Read"
# (o "Object Read & Write" si en algún momento se sube desde el backend)
# restringido a este bucket únicamente -- no uses un token de cuenta entera.
# CS2_R2_ACCOUNT_ID=
# CS2_R2_BUCKET=lineupscs2
# CS2_R2_ACCESS_KEY_ID=
# CS2_R2_SECRET_ACCESS_KEY=
